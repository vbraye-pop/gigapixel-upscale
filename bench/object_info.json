 "IrisUpscale": {
  "input": {
   "required": {
    "upscaler": [
     "IRIS_UPSCALER"
    ],
    "image": [
     "IMAGE"
    ],
    "scale": [
     "FLOAT",
     {
      "default": 4.0,
      "min": 1.0,
      "max": 4.0,
      "step": 0.5,
      "tooltip": "trained for 4x. Lower values restore at a smaller size"
     }
    ],
    "limit_input_size": [
     "BOOLEAN",
     {
      "default": true,
      "tooltip": "shrink the input first so its short side is at most 512 px and its long side at most 1024 px (at 4x: at most 2048x4096, 21 tiles). Off keeps the input size, and the time grows with the output area"
     }
    ],
    "color_fix": [
     "BOOLEAN",
     {
      "default": true,
      "tooltip": "keep the input's colors (wavelet color fix)"
     }
    ]
   }
  },
  "output": [
   "IMAGE"
  ]
 },
